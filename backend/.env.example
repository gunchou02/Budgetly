APP_NAME=Budgetly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:8080
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=receipts
REDIS_QUEUE_RETRY_AFTER=60
REDIS_QUEUE_BLOCK_FOR=5

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=budgetly
DB_USERNAME=budgetly
DB_PASSWORD=secret

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

FRONTEND_URL=http://localhost:5173

FILESYSTEM_DISK=local
RECEIPT_STORAGE_DISK=local
RECEIPT_MAX_UPLOAD_KB=5120
RECEIPT_MAX_PIXELS=40000000
RECEIPT_UPLOAD_RATE_PER_MINUTE=10

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=local-ai-secret
AI_SERVICE_CONNECT_TIMEOUT=3
AI_SERVICE_TIMEOUT=25
AI_SERVICE_REPORT_TIMEOUT=25
AI_SERVICE_MAX_EXTRACTED_TEXT_LENGTH=16000
AI_REPORT_RATE_PER_MINUTE=10
AI_REPORT_CACHE_TTL_SECONDS=21600
