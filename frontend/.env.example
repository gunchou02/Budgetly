DIRECT_URL=postgresql://budgetly:secret@127.0.0.1:5432/budgetly?schema=public

AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_API_TOKEN=local-ai-secret
CRON_SECRET=local-cron-secret
RATE_LIMIT_KEY_SECRET=local-rate-limit-secret

