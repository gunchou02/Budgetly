COMPOSE_PROJECT_NAME=budgetly

FRONTEND_PORT=5173
POSTGRES_PORT=5432
AI_PORT=8000

AI_INTERNAL_API_TOKEN=local-ai-secret
AI_RECEIPT_PROVIDER=fake
AI_REPORT_PROVIDER=fake
AI_OPENAI_MODEL=gpt-4o-mini
AI_REPORT_CACHE_TTL_SECONDS=3600

# Set only when either provider above is openai. Never commit the real key.
OPENAI_API_KEY=

POSTGRES_DB=budgetly
POSTGRES_USER=budgetly
POSTGRES_PASSWORD=secret

# Local defaults. Production receives managed values from Vercel.
NEXT_PUBLIC_RECEIPT_UPLOAD_MODE=server
RECEIPT_STORAGE_DRIVER=local
BUDGETLY_QUEUE_DRIVER=inline
BLOB_READ_WRITE_TOKEN=
VERCEL_QUEUE_API_TOKEN=
